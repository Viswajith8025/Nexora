# Frontend (browser-safe — VITE_ prefix exposes to client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — configure in Supabase Edge Function secrets / dashboard
# Never use VITE_ prefix for these values.
# SUPABASE_SERVICE_ROLE_KEY=
# GROQ_API_KEY=          # Required for process-articles Edge Function
# GROQ_MODEL_CLASSIFICATION=llama-3.1-8b-instant
# GROQ_MODEL_SUMMARY=llama-3.3-70b-versatile
# GROQ_MODEL_REASONING=llama-3.3-70b-versatile
# PROCESS_BATCH_SIZE=10
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# CRON_SECRET=          # Required for ingest-sources and dispatch-* Edge Functions
# GOOGLE_CLIENT_ID=      # Gmail OAuth (optional secondary channel)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # e.g. https://<project>.supabase.co/functions/v1/gmail-oauth
# APP_URL=               # e.g. https://your-app.vercel.app (CORS + OAuth redirect)
