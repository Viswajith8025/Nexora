# Frontend (Vite — safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Bot username without @ — enables "Open in Telegram" links in Settings
VITE_TELEGRAM_BOT_USERNAME=

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# Never prefix these with VITE_
GROQ_API_KEY=
GROQ_MODEL_CHEAP=openai/gpt-oss-20b
GROQ_MODEL_DEEP=openai/gpt-oss-120b
# Gemini fallback — used when Groq rate-limits (get key at aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-2.0-flash
GEMINI_MODEL_DEEP=gemini-2.5-flash
PROCESS_BATCH_SIZE=5
CRON_SECRET=givemedailyupdates@2026
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
APP_URL=http://localhost:5173,http://localhost:5175

# Optional — email digests via Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
